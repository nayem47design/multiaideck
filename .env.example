# Copy to .env and fill in. Never commit .env.
# Every service is optional in development: unset keys fall back to local stand-ins
# (embedded database, codes in the server log, sandbox checkout, scripted AI answers).
# Production refuses to start without the database, auth secret, SMS and PayStation.

FIGMA_ACCESS_TOKEN=

APP_URL=http://localhost:3000
DATABASE_URL=
# 32+ random characters, e.g. `openssl rand -base64 32`
AUTH_SECRET=

# SMS gateway (Bangladesh). SMS_PROVIDER=console prints codes to the server log.
SMS_PROVIDER=console
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=

# Google sign-in (OAuth client, redirect URI: <APP_URL>/api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI providers (server only). A model without a key uses the scripted demo model.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=

# PayStation (bKash, Nagad, card). Without merchant keys the in-app sandbox checkout is used.
PAYSTATION_BASE_URL=https://sandbox.paystation.com.bd
PAYSTATION_MERCHANT_ID=
PAYSTATION_PASSWORD=

# Development only: the demo account's phone number (default +880 1712 345 214).
# Signing in with it loads the prototype's demo data.
DEMO_PHONE=
