{
  "name": "multiaideck",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "tokens": "node scripts/generate-tokens.mjs && node scripts/generate-component-tokens.mjs && prettier --write src/styles/*.css src/styles/*.md src/styles/tokens.generated.ts",
    "icons": "node scripts/generate-icons.mjs && prettier --write src/components/atoms/Icon/icons.generated.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=desktop --project=mobile --pass-with-no-tests",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepare": "husky",
    "test:visual": "playwright test --project=visual"
  },
  "dependencies": {
    "ai": "^7.0.141",
    "drizzle-orm": "^0.45.4",
    "motion": "^14.2.0",
    "next": "16.4.1",
    "next-intl": "^4.14.9",
    "postgres": "^3.4.9",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/nextjs-vite": "^10.6.2",
    "@tailwindcss/turbopack": "^4",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-storybook": "^10.6.2",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.6.0",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "storybook": "^10.6.2",
    "storybook-addon-pseudo-states": "^10.6.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md,mdx,yml,yaml}": "prettier --write"
  }
}
